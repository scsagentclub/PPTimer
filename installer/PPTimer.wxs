<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PPTimer" Manufacturer="scsagentclub"
           Version="$(var.ProductVersion)" Language="1033" Scope="perUser"
           UpgradeCode="F8C31902-FA11-4ED1-9E1D-A8427EB2C702">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PPTimer is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="TimerIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TimerIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="PPTimer">
        <Component Id="Application" Guid="*">
          <File Id="TimerExe" Source="$(var.SourceExe)" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\scsagentclub\PPTimer"
                         Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuFolder" Name="PPTimer">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="LaunchTimer" Name="PPTimer" Target="[#TimerExe]"
                    WorkingDirectory="INSTALLFOLDER" Icon="TimerIcon" />
          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\scsagentclub\PPTimer"
                         Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="PPTimer" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
